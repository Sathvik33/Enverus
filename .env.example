# --- Database (Neon PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?ssl=require

# --- LLM Configuration (Ollama or Groq) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# Optional: Groq Cloud API (if laptop lacks GPU/RAM for local Qwen)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# --- Text Embedding ---
TEXT_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
TEXT_EMBEDDING_DIM=768

# --- Image Embedding (SigLIP) ---
IMAGE_EMBEDDING_MODEL=google/siglip-base-patch16-224
IMAGE_EMBEDDING_DIM=768

# --- Reranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval ---
TOP_K=10
FINAL_TOP_K=5
RRF_K=60

# --- Chunking ---
CHUNK_SIZE=600
CHUNK_OVERLAP=80

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
UPLOAD_DIR=data/documents
IMAGE_DIR=data/images

# --- Guardrails ---
PII_DETECTION_ENABLED=true
OUTPUT_GROUNDING_ENABLED=true

# --- Streamlit ---
BACKEND_URL=http://localhost:8000
